TELEGRAM_BOT_TOKEN=123456789:reemplaza_este_valor_con_el_token_real_de_botfather
LOG_LEVEL=INFO
# Proxy de salida (WireGuard user-space -> VPN) para casas que bloquean la IP del
# server. Vacío = salida directa. Ver deploy/VPN-SETUP.md.
# BOT_PROXY_URL=socks5://127.0.0.1:25344
# Ruteo SELECTIVO: si listás plataformas acá, SOLO esas salen por la VPN; el resto
# (incl. Telegram, Sportradar y las casas argentinas) va directo. Vacío = TODO por
# la VPN (legacy). Necesario porque MrPunter/Solcasino requieren VPN, pero
# Betsson/BetWarrior (AR) se rompen con un exit extranjero (302 a otro país).
# BOT_PROXY_PLATFORMS=mrpunter_http,solcasino_http
# Zona horaria por defecto para mostrar horarios (partidos, avisos, lives) cuando
# un chat no definió la suya con /timezone. Nombre IANA. Default: Argentina.
# BOT_DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
TRACKING_REFRESH_INTERVAL_SECONDS=120
# Cadencia del tier "in-play" (partido en vivo o a <=15 min del kickoff). Es lo
# que define qué tan rápido se detecta un gol/movida en vivo. Más bajo = más
# reactivo pero más carga/requests en la VPS. El tick del monitor baja a este
# valor automáticamente para poder cumplirlo.
TRACKING_LIVE_REFRESH_SECONDS=20
# Fast-path de alertas: una movida >= a este % (puntos porcentuales, tipo gol) y
# que no esté flapeando se avisa en el PRIMER refresh en vez de esperar la
# confirmación de 2 ciclos. Poner muy alto para desactivarlo de hecho.
ODDS_FAST_PATH_PERCENT=40.0
TRACKING_MAX_PARALLEL_REFRESHES=3
EXTRACTOR_BROWSER_ENABLED=true
# Mystake (prematch HTTP). Trae un host por defecto que funciona; override solo si rota.
# MYSTAKE_API_BASE_URL=https://analytics-sp.googleserv.tech
MYSTAKE_REGION=as
MYSTAKE_SPORT_ID=1
MYSTAKE_LANGUAGE=28
# Modo del navegador para mintear el token de Statshub. OJO: Akamai BLOQUEA el
# headless (no devuelve token); el headed sí funciona. En un server sin monitor,
# poné 'headed' y corré el bot bajo Xvfb (display virtual) -> ver deploy/SPORTRADAR-CHROME.md.
# headless: sin GUI · headed: navegador real (invisible bajo Xvfb) · auto: prueba headless y cae a headed.
# Este modo aplica también al pre-refresh de fondo (salvo que fijes SPORTRADAR_BACKGROUND_BOOTSTRAP_MODE).
SPORTRADAR_BOOTSTRAP_MODE=headless
# SPORTRADAR_BACKGROUND_BOOTSTRAP_MODE=headless   # forzar el pre-refresh de arranque a headless (desktop)
# REPLAY-ONLY: el server NUNCA abre navegador. Generás el token en tu PC y lo subís
# por Telegram con /sportradar_token (o scp del session_state_headed.json). Ideal en
# VPS chica donde Akamai bloquea headless y headed se cuelga. Ver deploy/SPORTRADAR-CHROME.md.
# SPORTRADAR_REPLAY_ONLY=true
# STATS_SESSION_REFRESH_ENABLED=false   # sin pre-refresh de token en loop (recomendado con replay-only)
# STATS_PREFETCH_ENABLED=false          # sin warm-up diario que dispara Chrome
# Requests en paralelo al generar un reporte de stats (cap moderado: rápido + amigable con anti-bot).
SPORTRADAR_MATCH_FETCH_CONCURRENCY=5
# Cache de payloads de stats en SQLite (anti-ban + velocidad). TTL en segundos.
SPORTRADAR_CACHE_ENABLED=true
SPORTRADAR_CACHE_TTL_SECONDS=900
# Prefetch diario: precarga liga + reportes de partidos trackeados (1x/día) para que /stats no busque.
# En una VM chica donde Chrome (Sportradar) es pesado, poné false (evita lanzar Chrome por cada liga).
STATS_PREFETCH_ENABLED=true
STATS_PREFETCH_INTERVAL_SECONDS=86400
STATS_PREFETCH_TTL_SECONDS=90000
# Pre-refresh del token de Sportradar en segundo plano (abre Chrome cada 30 min).
# En VM chica poné false: el token se mintea solo on-demand al usar /stats (un solo Chrome, no en loop).
STATS_SESSION_REFRESH_ENABLED=true
# FootyStats HTTP público: discovery, tabla, fixtures y marcador live liviano.
# La key oficial es opcional hoy y permitirá ampliar H2H/odds/stats licenciadas.
FOOTYSTATS_ENABLED=true
# FOOTYSTATS_API_KEY=
# --- Toggles de proveedores de stats (todos HTTP) ---
FLASHSCORE_ENABLED=true
# SofaScore puede devolver challenge anti-bot; off por defecto (los links viejos siguen).
SOFASCORE_ENABLED=false
# Suecia (FOGIS) y federaciones especiales (Noruega/Rumania/Eslovaquia/Argelia) como stats providers linkeables.
SVENSKFOTBOLL_ENABLED=true
FEDERATION_STATS_ENABLED=true
# --- Live watch (alertas de gol/tarjeta) ---
# Cadencia normal en segundos; durante un partido en juego baja a 10s sola.
LIVE_WATCH_ENABLED=true
LIVE_WATCH_INTERVAL_SECONDS=15
# Auto-import de la planilla a la watchlist. Se ACTIVA SOLO si ponés el chat id
# destino. Re-importa al detectar cambios en la planilla (poll cada N seg);
# add_fixture_lines deduplica, así que es idempotente.
# LIVE_WATCH_SHEET_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=0
# LIVE_WATCH_SHEET_CHAT_ID=123456789
LIVE_WATCH_SHEET_INTERVAL_SECONDS=900
# Peak digest diario (Finlandia + Suecia). Apagalo en VMs muy chicas si no lo usás.
PEAK_DIGEST_ENABLED=true
EXTRACTOR_MAX_PARALLEL_COMPETITIONS=1
EXTRACTOR_MAX_PARALLEL_PAGES=3
EXTRACTOR_MAX_PARALLEL_EVENT_PAGES=1
EXTRACTOR_PAGE_REUSE_ENABLED=false
EXTRACTOR_BROWSER_RESTART_AFTER_N_REFRESHES=
EXTRACTOR_BROWSER_RESTART_IDLE_TTL_SECONDS=
EXTRACTOR_PAGE_LOAD_TIMEOUT_MS=60000
EXTRACTOR_POST_LOAD_WAIT_MS=4000
EXTRACTOR_HEADLESS=true
EXTRACTOR_CAPTURE_WAIT_TIMEOUT_MS=25000
EXTRACTOR_CAPTURE_STABLE_MS=1500
EXTRACTOR_CAPTURE_ATTEMPTS=2
EXTRACTOR_EVENT_CAPTURE_WAIT_TIMEOUT_MS=20000
EXTRACTOR_EVENT_CAPTURE_STABLE_MS=1200
EXTRACTOR_EVENT_CAPTURE_ATTEMPTS=1
EXTRACTOR_SAVE_DEBUG_PAYLOADS=false
# EXTRACTOR_DEBUG_PAYLOAD_DIR=debug/bet365
EXTRACTOR_EXTRACT_ALTERNATIVE_MARKETS=false
BET365_ALLOW_LEGACY_FALLBACK=false
TRACKING_DEFAULT_CHANGE_THRESHOLD_PERCENT=20.0
TRACKING_DEFAULT_NOTIFY_ODDS_CHANGES=true
TRACKING_REMOVE_MISSING_AFTER_CYCLES=3
ENABLE_MONITORING=false
MONITOR_INTERVAL_SECONDS=60
MONITOR_LOG_TO_FILE=false
MONITOR_CHROMIUM_RAM_ALERT_MB=800
