# BetBot corriendo DENTRO del network namespace de la VPN (botvpn).
# Todo el tráfico del bot sale por ProtonVPN; SSH/host quedan en la red directa.
[Unit]
Description=BetBot Telegram
After=network-online.target botvpn.service
Wants=network-online.target
Requires=botvpn.service

[Service]
Type=simple
User=maximilianogatto
WorkingDirectory=/home/maximilianogatto/betbot
ExecStart=/home/maximilianogatto/betbot/run.sh
Restart=always
RestartSec=10
CPUQuota=90%
MemoryHigh=800M
MemoryMax=2600M
# Correr en el namespace de red de la VPN + usar el DNS de Proton dentro de él.
NetworkNamespacePath=/run/netns/botvpn
BindReadOnlyPaths=/etc/netns/botvpn/resolv.conf:/etc/resolv.conf

[Install]
WantedBy=multi-user.target
